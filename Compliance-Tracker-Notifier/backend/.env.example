# JWT Authentication Configuration
# IMPORTANT: Change this to a secure random string in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Slack Integration Configuration
# Get your Slack Webhook URL from: https://api.slack.com/messaging/webhooks

# Slack Incoming Webhook URL
# Example: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=

# Database Configuration
DATABASE_URL=sqlite:////app/data/compliance_tracker.db

# Notification Schedule (Optional - uses default if not set)
# Daily summary time (24-hour format)
DAILY_SUMMARY_HOUR=9
DAILY_SUMMARY_MINUTE=0

# Overdue tasks check time
OVERDUE_CHECK_HOUR=10
OVERDUE_CHECK_MINUTE=0

# Weekly summary day (0=Monday, 6=Sunday)
WEEKLY_SUMMARY_DAY=0
WEEKLY_SUMMARY_HOUR=9
WEEKLY_SUMMARY_MINUTE=0